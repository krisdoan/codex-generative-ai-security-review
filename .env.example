# Gemini image generation key for local/server use.
GEMINI_API_KEY=

# Optional Firebase/Firestore configuration for persistent users, logs, and app config.
FIRESTORE_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional Vercel Blob token for shared generated assets.
BLOB_READ_WRITE_TOKEN=

# Optional app/session settings.
OD_AUTH_SECRET=
CRON_SECRET=
OD_IMAGE_MODEL=gemini-3.1-flash-image-preview
